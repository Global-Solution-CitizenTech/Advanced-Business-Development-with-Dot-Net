# Oracle Database (Local via Docker - FreePDB1 / Express XE)
ORACLE_APP_USER=zelafix
ORACLE_APP_PASSWORD=zelafix
ORACLE_DATA_SOURCE=localhost:1521/FREEPDB1

# Oracle Database (FIAP Nuvem - Alternativa)
# ORACLE_APP_USER=rm561432
# ORACLE_APP_PASSWORD=sua_senha_fiap
# ORACLE_DATA_SOURCE=oracle.fiap.com.br:1521/ORCL

# Connection String Direta para o Entity Framework Core (.NET 10)
ConnectionStrings__ZelaFixOracle=User Id=zelafix;Password=zelafix;Data Source=localhost:1521/FREEPDB1;

# JWT Authentication (RFC 7519 - HS256, mínimo 32 caracteres)
Jwt__Key=zelafix-super-secret-jwt-token-key-2026-min-32-chars-long!
Jwt__Issuer=ZelaFix.API
Jwt__Audience=ZelaFix.Clients
Jwt__ExpirationMinutes=120

# Rate Limiting (Políticas nativas Fixed Window do ASP.NET Core)
RateLimiting__GlobalPermitLimit=100
RateLimiting__AuthPermitLimit=10
RateLimiting__WindowSeconds=60
